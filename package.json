{
  "name": "trello",
  "private": true,
  "version": "1.0.0",
  "author": "Duy Cuong",
  "description": "#",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true }); require('fs').mkdirSync('build');\"",
    "build-babel": "babel ./src -d ./build/src",
    "build": "npm run clean && npm run build-babel",
    "start": "cross-env BUILD_MODE=production node ./build/src/server.js",
    "production": "npm run build && cross-env BUILD_MODE=production node ./build/src/server.js",
    "dev": "cross-env BUILD_MODE=dev nodemon --exec babel-node ./src/server.js",
    "test": "node --test --test-concurrency=1 tests/",
    "test:e2e": "node --test --test-concurrency=1 tests/integration/"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "async-exit-hook": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongodb": "^6.0.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.8.4",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
